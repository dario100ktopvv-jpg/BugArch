#!/bin/bash

AUTO_YES=false
AUTO_NO=false
QUIET=false

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -Y) AUTO_YES=true; shift ;;
        -N) AUTO_NO=true; shift ;;
        -Q) QUIET=true; shift ;;
        -*) echo "Opzione non valida: $1" >&2; exit 1 ;;
        *) shift ;;
    esac
done

if [ "$AUTO_NO" = true ]; then
    [ "$QUIET" = false ] && echo "Operazione annullata per flag -N."
    exit 0
fi

# Rilevamento dello spazio su disco principale
DISK_USAGE=""
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || -n "$WINDIR" ]]; then
    if command -v powershell.exe &>/dev/null; then
        DISK_USAGE=$(powershell.exe -Command "
            \$d = Get-CimInstance Win32_LogicalDisk -Filter \"DeviceID='C:'\";
            if (\$d) {
                \$used = \$d.Size - \$d.FreeSpace;
                \$pct = [math]::Round((\$used / \$d.Size) * 100);
                Write-Output \"\$pct%\"
            }
        " 2>/dev/null | tr -d '\r' | xargs)
    fi
fi

# Fallback per Linux se non rilevato tramite PowerShell
if [ -z "$DISK_USAGE" ]; then
    DISK_USAGE=$(df -h / 2>/dev/null | awk 'NR==2 {print $5}')
fi

[ -z "$DISK_USAGE" ] && DISK_USAGE="N/A"

# Estrazione del valore numerico per la verifica delle soglie
PCT_NUM=$(echo "$DISK_USAGE" | tr -d '%')

STATUS="OK: Normal parameters"
if [[ "$PCT_NUM" =~ ^[0-9]+$ ]]; then
    if [ "$PCT_NUM" -ge 90 ]; then
        STATUS="CRITICAL: Disk space running out ($DISK_USAGE)"
    elif [ "$PCT_NUM" -ge 75 ]; then
        STATUS="WARNING: Disk usage high ($DISK_USAGE)"
    fi
fi

# Output Quiet (-Q)
if [ "$QUIET" = true ]; then
    echo "PCS_DISK: $DISK_USAGE | STATUS: $STATUS"
    exit 0
fi

# Output Standard
echo "=========================================="
echo "      BugArch OS - PCS Health Suite       "
echo "=========================================="
echo "[*] Utilizzo disco principale: $DISK_USAGE"
echo "[*] Stato del sistema: $STATUS"
echo "=========================================="