#!/bin/bash

echo "=========================================="
echo "          BugArch OS - PC State           "
echo "=========================================="

if grep -q "Microsoft" /proc/version 2>/dev/null || uname -s | grep -q "MINGW\|MSYS"; then
    echo "[Ambiente Rilevato: Windows]"
    
    cpu_usage=$(powershell -Command "(Get-CimInstance Win32_Processor).LoadPercentage" | tr -d '\r')
    if [ -n "$cpu_usage" ]; then
        cpu_health=$(( 100 - cpu_usage ))
    else
        cpu_health=100
    fi

    ram_free_mb=$(powershell -Command "(Get-CimInstance Win32_OperatingSystem).FreePhysicalMemory / 1024" | awk -F',' '{print $1}' | awk -F'.' '{print $1}')
    ram_total_mb=$(powershell -Command "(Get-CimInstance Win32_OperatingSystem).TotalVisibleMemorySize / 1024" | awk -F',' '{print $1}' | awk -F'.' '{print $1}')
    
    if [ -n "$ram_total_mb" ] && [ "$ram_total_mb" -gt 0 ]; then
        ram_health=$(( ram_free_mb * 100 / ram_total_mb ))
    else
        ram_health=0
    fi

    gpu_info=$(powershell -Command "(Get-CimInstance Win32_VideoController).Name" | tr -d '\r' | head -n 1)
    gpu_usage=$(powershell -Command "(Get-CimInstance Win32_PerfFormattedData_GPUPerformanceCounters_GPUEngine | Measure-Object -Property UtilizationPercentage -Sum).Sum" 2>/dev/null | tr -d '\r')
    
    if [ -n "$gpu_usage" ] && [ "$gpu_usage" -gt 0 ]; then
        gpu_health=$(( 100 - gpu_usage ))
    else
        gpu_health=100
    fi

else
    echo "[Ambiente Rilevato: Linux]"

    mem_total=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    mem_avail=$(grep MemAvailable /proc/meminfo | awk '{print $2}')
    ram_health=$(( mem_avail * 100 / mem_total ))

    cpu_idle=$(top -bn1 | grep "Cpu(s)" | awk '{print $8}' | awk -F'.' '{print $1}')
    if [ -n "$cpu_idle" ]; then
        cpu_health=$cpu_idle
    else
        cpu_health=100
    fi

    if command -v nvidia-smi &> /dev/null; then
        gpu_info=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -n 1)
        gpu_util=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits | head -n 1)
        gpu_health=$(( 100 - gpu_util ))
    else
        gpu_info="Integrata / Non Nvidia"
        gpu_health=100
    fi
fi

echo "Stato CPU (Risorse Libere): $cpu_health%"
echo "Stato RAM (Risorse Libere): $ram_health%"
if [ -n "$gpu_info" ]; then
    echo "GPU Rilevata: $gpu_info"
    echo "Stato GPU (Risorse Libere): $gpu_health%"
fi

echo "------------------------------------------"
avg_health=$(( (cpu_health + ram_health + gpu_health) / 3 ))

if [ $avg_health -ge 90 ]; then
    echo "Stato Generale BugArch: $avg_health% [OTTIMO]"
elif [ $avg_health -ge 70 ]; then
    echo "Stato Generale BugArch: $avg_health% [STABILE]"
else
    echo "Stato Generale BugArch: $avg_health% [ATTENZIONE - SOTTO SOGLIA]"
fi
echo "=========================================="