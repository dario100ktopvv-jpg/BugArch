#!/bin/bash

AUTO_YES=false
AUTO_NO=false
QUIET=false

while [[ "$#" -gt 0 ]]; do
    case $1 in
        -Y) AUTO_YES=true; shift ;;
        -N) AUTO_NO=true; shift ;;
        -Q) QUIET=true; shift ;;
        -*) echo "Opzione non valida: $1" >&2; exit 1 ;;
        *) shift ;;
    esac
done

if [ "$QUIET" = false ]; then
    echo "=========================================="
    echo "      BugArch OS - Deta Recycler          "
    echo "=========================================="
fi

if [ "$AUTO_NO" = true ]; then
    [ "$QUIET" = false ] && echo "[*] Flag -N attivo: Operazione di riciclo interrotta."
    exit 0
fi

if [ "$AUTO_YES" = false ] && [ "$QUIET" = false ]; then
    read -p "Vuoi procedere con il riciclo dei processi inattivi? [s/N]: " confirm
    [[ "$confirm" =~ ^[sS]$ ]] || { echo "Annullato."; exit 0; }
fi

RECYCLED=0
if [ "$QUIET" = true ]; then
    echo "RECYCLED: $RECYCLED processes"
else
    echo "[OK] Riciclo completato. Elementi liberati: $RECYCLED"
    echo "=========================================="
fi