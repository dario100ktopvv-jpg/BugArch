#!/bin/bash

echo "=========================================="
echo "    BugArch OS - Real Diagnostic Engine   "
echo "=========================================="

if grep -q "Microsoft" /proc/version 2>/dev/null || uname -s | grep -q "MINGW\|MSYS"; then
    OS_TYPE="Windows"
else
    OS_TYPE="Linux"
fi

# Rilevamento metriche reali
if [ "$OS_TYPE" = "Windows" ]; then
    cpu_usage=$(powershell -Command "(Get-CimInstance Win32_Processor).LoadPercentage" 2>/dev/null | tr -d '\r')
    [ -z "$cpu_usage" ] && cpu_usage=0
    cpu_health=$(( 100 - cpu_usage ))

    ram_free_mb=$(powershell -Command "(Get-CimInstance Win32_OperatingSystem).FreePhysicalMemory / 1024" 2>/dev/null | awk -F',' '{print $1}' | awk -F'.' '{print $1}')
    ram_total_mb=$(powershell -Command "(Get-CimInstance Win32_OperatingSystem).TotalVisibleMemorySize / 1024" 2>/dev/null | awk -F',' '{print $1}' | awk -F'.' '{print $1}')
    if [ -n "$ram_total_mb" ] && [ "$ram_total_mb" -gt 0 ]; then
        ram_health=$(( ram_free_mb * 100 / ram_total_mb ))
    else
        ram_health=100
    fi
else
    mem_total=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    mem_avail=$(grep MemAvailable /proc/meminfo | awk '{print $2}')
    ram_health=$(( mem_avail * 100 / mem_total ))

    cpu_idle=$(top -bn1 | grep "Cpu(s)" | awk '{print $8}' | awk -F'.' '{print $1}')
    [ -n "$cpu_idle" ] && cpu_health=$cpu_idle || cpu_health=100
fi

# Assegnazione errore basata su condizioni reali
error_code="0x0000000"
error_desc="Sistema operativo integro e stabile."

if [ $ram_health -lt 10 ]; then
    error_code="0x0000034"
    error_desc="Modulo RAM critico: risorse quasi esaurite (< 10% libere)."
elif [ $cpu_health -lt 5 ]; then
    error_code="0x00000355"
    error_desc="Anomalia critica hardware: CPU sovraccarica o non responsiva."
fi

echo "------------------------------------------"
if [ "$error_code" != "0x0000000" ]; then
    echo -e "\033[1;31m[CRITICAL ERROR] Codice: $error_code\033[0m"
    echo "Diagnosi: $error_desc"
    echo ""
    echo -n "Vuoi avviare la procedura di correzione d'emergenza? (s/n): "
    read risposta
    
    if [ "$risposta" = "s" ] || [ "$risposta" = "S" ]; then
        echo "Ottimizzazione dei processi in corso..."
        sleep 2
        echo "[OK] Procedura completata. Risorse ripristinate."
    else
        echo "[ATTENZIONE] Nessuna azione intrapresa."
    fi
else
    echo -e "\033[1;32m[STATUS: OK] Codice: $error_code\033[0m"
    echo "Diagnosi: $error_desc"
fi
echo "=========================================="